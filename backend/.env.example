# ==========================================
# Indian Bazar Backend Configuration (.env)
# ==========================================

# Django Settings
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-indian-bazar-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (SQLite default; inspectable via DB Browser)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# JWT Authentication (djangorestframework-simplejwt)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Email Configuration (for order notifications & password reset)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL="Indian Bazar <noreply@indianbazar.com>"
